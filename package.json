{
  "name": "skippr-ide",
  "description": "Skippr IDE VSCode fork bootstrap and build tooling",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "bootstrap:fork": "bash scripts/bootstrap_vscode_fork.sh",
    "apply:overlay": "node scripts/apply_skippr_overlay.mjs",
    "build:ide": "bash scripts/build_skippr_ide.sh",
    "dev": "bash scripts/run_dev_mode.sh",
    "package:darwin:x64": "bash scripts/package_skippr_ide.sh darwin x64",
    "package:darwin:arm64": "bash scripts/package_skippr_ide.sh darwin arm64",
    "package:linux:x64": "bash scripts/package_skippr_ide.sh linux x64",
    "package:linux:arm64": "bash scripts/package_skippr_ide.sh linux arm64",
    "package:linux:armhf": "bash scripts/package_skippr_ide.sh linux armhf",
    "package:win32:x64": "bash scripts/package_skippr_ide.sh win32 x64",
    "package:win32:arm64": "bash scripts/package_skippr_ide.sh win32 arm64",
    "verify:fork": "bash scripts/verify_fork_setup.sh",
    "build:rust": "cargo build --manifest-path rust-core/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^20.14.2"
  }
}
