{
  "name": "skippr-workbench",
  "displayName": "Skippr Workbench",
  "description": "Built-in Skippr IDE workbench module",
  "version": "0.0.1",
  "publisher": "skippr",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configurationDefaults": {
      "workbench.startupEditor": "none",
      "workbench.welcomePage.experimentalOnboarding": false,
      "testing.gutterEnabled": true,
      "[yaml]": {
        "editor.codeLens": true
      }
    },
    "authentication": [
      {
        "id": "skippr",
        "label": "Skippr"
      }
    ],
    "commands": [
      {
        "command": "skippr.auth.refresh",
        "title": "Skippr: Refresh auth token"
      },
      {
        "command": "skippr.configureConnection",
        "title": "Skippr: Configure Connection"
      },
      {
        "command": "skippr.openSplash",
        "title": "Skippr: Open Welcome"
      },
      {
        "command": "skippr.auth.signIn",
        "title": "Skippr: Sign In"
      },
      {
        "command": "skippr.auth.signOut",
        "title": "Skippr: Sign Out"
      },
      {
        "command": "skippr.auth.account",
        "title": "Skippr: Account"
      },
      {
        "command": "skippr.open.discover",
        "title": "Skippr: Open Discover Panel"
      },
      {
        "command": "skippr.open.sync",
        "title": "Skippr: Open Sync Panel"
      },
      {
        "command": "skippr.open.model",
        "title": "Skippr: Model"
      },
      {
        "command": "skippr.open.catalog",
        "title": "Skippr: Catalog"
      },
      {
        "command": "skippr.open.lineage",
        "title": "Skippr: Lineage"
      },
      {
        "command": "skippr.run.discoverPipeline",
        "title": "Skippr: Discover Pipeline"
      },
      {
        "command": "skippr.run.syncPipelineOnce",
        "title": "Skippr: Sync Pipeline Once"
      },
      {
        "command": "skippr.run.syncAllOnce",
        "title": "Skippr: Sync All Once"
      },
      {
        "command": "skippr.run.startSyncPipeline",
        "title": "Skippr: Start Pipeline Sync"
      },
      {
        "command": "skippr.run.modelPipeline",
        "title": "Skippr: Model Pipeline"
      },
      {
        "command": "skippr.run.doctor",
        "title": "Skippr: Doctor"
      },
      {
        "command": "skippr.run.pickPipelineAction",
        "title": "Skippr: Run pipeline…"
      },
      {
        "command": "skippr.showPipelineRunMenu",
        "title": "Skippr: Show pipeline run menu"
      },
      {
        "command": "skippr.run.lens.discover",
        "title": "Discover",
        "icon": "$(search)"
      },
      {
        "command": "skippr.run.lens.sync",
        "title": "Sync (once)",
        "icon": "$(sync)"
      },
      {
        "command": "skippr.run.lens.model",
        "title": "Model",
        "icon": "$(circuit-board)"
      },
      {
        "command": "skippr.run.lens.doctor",
        "title": "Doctor",
        "icon": "$(pass)"
      },
      {
        "command": "skippr.run.lens.lineage",
        "title": "Lineage",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "skippr.run.lensWithArgs",
        "title": "Skippr: Run pipeline action"
      },
      {
        "command": "skippr.run.stopSyncPipeline",
        "title": "Skippr: Stop Pipeline Sync"
      },
      {
        "command": "skippr.cli.install",
        "title": "Skippr: Install CLI"
      },
      {
        "command": "skippr.cli.update",
        "title": "Skippr: Update CLI"
      },
      {
        "command": "skippr.cli.showVersion",
        "title": "Skippr: Show CLI Version"
      },
      {
        "command": "skippr.setupWorkspace",
        "title": "Skippr: Setup Workspace"
      },
      {
        "command": "skippr.validateConfiguration",
        "title": "Skippr: Validate Configuration"
      },
      {
        "command": "skippr.openConfig",
        "title": "Skippr: Open Config"
      },
      {
        "command": "skippr.editPipelineEnv",
        "title": "Skippr: Edit Pipeline Environment Variables"
      },
      {
        "command": "skippr.refreshDiagnostics",
        "title": "Skippr: Refresh Config Diagnostics"
      },
      {
        "command": "skippr.sql.newQuery",
        "title": "Skippr: New SQL Query"
      },
      {
        "command": "skippr.sql.runSelection",
        "title": "Skippr: Run SQL Selection"
      },
      {
        "command": "skippr.sql.runDocument",
        "title": "Run SQL",
        "icon": "$(debug-start)"
      },
      {
        "command": "skippr.sql.runDbtDocument",
        "title": "Run SQL|DBT",
        "icon": "$(debug-start)"
      },
      {
        "command": "skippr.sql.pickRunMode",
        "title": "Run mode",
        "icon": "$(chevron-down)"
      },
      {
        "command": "skippr.sql.setRunModeSql",
        "title": "SQL"
      },
      {
        "command": "skippr.sql.setRunModeTests",
        "title": "Tests"
      },
      {
        "command": "skippr.sql.askDataQuestion",
        "title": "Skippr: Ask Data Question"
      }
      ],
    "submenus": [
      {
        "id": "skippr.sql.runMode",
        "label": "Run SQL|DBT mode"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "skipprConnectionsActivity",
          "title": "Connections",
          "icon": "media/plug.svg"
        },
        {
          "id": "skipprLineageActivity",
          "title": "Lineage",
          "icon": "media/lineage-graph.svg"
        }
      ],
      "panel": [
        {
          "id": "skippr.run.timeline.panel",
          "title": "Run",
          "icon": "media/skippr.svg"
        },
        {
          "id": "skippr.run.deadletters.panel",
          "title": "Deadletters",
          "icon": "media/skippr.svg"
        },
        {
          "id": "skippr.query.results.panel",
          "title": "Results",
          "icon": "media/skippr.svg"
        }
      ]
    },
    "views": {
      "skipprConnectionsActivity": [
        {
          "id": "skippr.connections",
          "name": "Connections",
          "type": "webview",
          "order": 1
        }
      ],
      "skipprLineageActivity": [
        {
          "id": "skippr.lineageLaunch",
          "name": "Lineage",
          "type": "webview",
          "order": 1
        }
      ],
      "debug": [
        {
          "id": "skippr.runStatus",
          "name": "",
          "type": "webview",
          "order": 50
        }
      ],
      "skippr.run.timeline.panel": [
        {
          "id": "skippr.runTimeline",
          "name": "Run",
          "type": "webview",
          "order": 1
        }
      ],
      "skippr.run.deadletters.panel": [
        {
          "id": "skippr.runDeadletters",
          "name": "Deadletters",
          "type": "webview",
          "order": 1
        }
      ],
      "skippr.query.results.panel": [
        {
          "id": "skippr.queryResults",
          "name": "Results",
          "type": "webview",
          "order": 1
        }
      ]
    },
    "submenus": [
      {
        "id": "skippr.debug.toolbar",
        "label": "Skippr"
      },
      {
        "id": "skippr.pipelineRun",
        "label": "Run Skippr"
      }
    ],
    "menus": {
      "debug/toolBar": [
        {
          "submenu": "skippr.debug.toolbar",
          "group": "navigation@8",
          "when": "debuggersAvailable"
        }
      ],
      "skippr.pipelineRun": [
        {
          "command": "skippr.run.lens.discover",
          "group": "1@1"
        },
        {
          "command": "skippr.run.lens.sync",
          "group": "1@2"
        },
        {
          "command": "skippr.run.lens.model",
          "group": "1@3"
        },
        {
          "command": "skippr.run.lens.doctor",
          "group": "1@4"
        },
        {
          "command": "skippr.run.lens.lineage",
          "group": "1@5"
        }
      ],
      "skippr.debug.toolbar": [
        {
          "command": "skippr.run.pickPipelineAction",
          "group": "1_run@5"
        },
        {
          "command": "skippr.run.stopSyncPipeline",
          "group": "2_control@1"
        }
      ],
      "editor/title": [
        {
          "command": "skippr.sql.runDbtDocument",
          "group": "navigation@9",
          "when": "resourceLangId == sql && skippr.editorIsDbtSql"
        },
        {
          "command": "skippr.sql.runDocument",
          "group": "navigation@9",
          "when": "resourceLangId == sql && !skippr.editorIsDbtSql"
        },
        {
          "submenu": "skippr.sql.runMode",
          "group": "navigation@9",
          "when": "resourceLangId == sql && skippr.editorIsDbtSql && skippr.editorRunHasDbtTests"
        }
      ],
      "skippr.sql.runMode": [
        {
          "command": "skippr.sql.setRunModeSql",
          "group": "1@1"
        },
        {
          "command": "skippr.sql.setRunModeTests",
          "group": "1@2"
        }
      ],
      "editor/context": [
        {
          "command": "skippr.sql.runSelection",
          "group": "navigation@9",
          "when": "editorLangId == sql"
        },
        {
          "command": "skippr.sql.runDbtDocument",
          "group": "navigation@10",
          "when": "editorLangId == sql && skippr.editorIsDbtSql"
        },
        {
          "command": "skippr.sql.runDocument",
          "group": "navigation@10",
          "when": "editorLangId == sql && !skippr.editorIsDbtSql"
        }
      ],
      "commandPalette": [
        {
          "command": "skippr.showPipelineRunMenu",
          "when": "false"
        },
        {
          "command": "skippr.run.lens.discover",
          "when": "false"
        },
        {
          "command": "skippr.run.lens.sync",
          "when": "false"
        },
        {
          "command": "skippr.run.lens.model",
          "when": "false"
        },
        {
          "command": "skippr.run.lens.doctor",
          "when": "false"
        },
        {
          "command": "skippr.run.lens.lineage",
          "when": "false"
        },
        {
          "command": "skippr.run.lensWithArgs",
          "when": "false"
        },
        {
          "command": "skippr.auth.signIn"
        },
        {
          "command": "skippr.auth.signOut"
        },
        {
          "command": "skippr.auth.account"
        },
        {
          "command": "skippr.open.discover"
        },
        {
          "command": "skippr.open.sync"
        },
        {
          "command": "skippr.open.model"
        },
        {
          "command": "skippr.run.discoverPipeline"
        },
        {
          "command": "skippr.run.syncPipelineOnce"
        },
        {
          "command": "skippr.run.syncAllOnce"
        },
        {
          "command": "skippr.run.startSyncPipeline"
        },
        {
          "command": "skippr.run.modelPipeline"
        },
        {
          "command": "skippr.run.doctor"
        },
        {
          "command": "skippr.run.stopSyncPipeline"
        },
        {
          "command": "skippr.cli.install"
        },
        {
          "command": "skippr.cli.update"
        },
        {
          "command": "skippr.cli.showVersion"
        },
        {
          "command": "skippr.setupWorkspace"
        },
        {
          "command": "skippr.validateConfiguration"
        },
        {
          "command": "skippr.openConfig"
        },
        {
          "command": "skippr.editPipelineEnv"
        },
        {
          "command": "skippr.refreshDiagnostics"
        }
      ]
    },
    "debuggers": [
      {
        "type": "skippr",
        "label": "Skippr",
        "languages": [
          "yaml"
        ],
        "program": "./out/extension.js",
        "configurationAttributes": {
          "launch": {
            "required": ["type", "request", "name", "skipprKind"],
            "properties": {
              "type": {
                "enum": ["skippr"]
              },
              "request": {
                "enum": ["launch"]
              },
              "name": {
                "type": "string"
              },
              "skipprKind": {
                "type": "string",
                "enum": ["discover", "sync", "sync-once", "sync-all-once", "model", "doctor", "test"],
                "description": "discover; sync or sync-once for one sync pass; sync-all-once; model; doctor; test (dbt)."
              },
              "pipeline": {
                "type": "string",
                "description": "Pipeline name. When empty, launch resolution uses skippr.defaultPipeline when set."
              },
              "configPath": {
                "type": "string",
                "description": "Path to skippr.yml or skippr.yaml. Defaults to the auto-detected workspace config."
              },
              "logLevel": {
                "type": "string",
                "enum": ["debug", "info", "warn", "error"],
                "description": "Log level passed to Skippr."
              },
              "skipprExtraArgs": {
                "type": "string",
                "description": "Optional extra CLI arguments (space-separated; basic quoting supported)."
              },
              "skipprTestSelect": {
                "type": "string",
                "description": "For skipprKind test: optional dbt --select value (e.g. test unique_id)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "skippr",
            "request": "launch",
            "name": "Skippr: Discover",
            "skipprKind": "discover",
            "configPath": "${workspaceFolder}/skippr.yml",
            "logLevel": "info",
            "pipeline": "${config:skippr.defaultPipeline}"
          },
          {
            "type": "skippr",
            "request": "launch",
            "name": "Skippr: Sync",
            "skipprKind": "sync-once",
            "configPath": "${workspaceFolder}/skippr.yml",
            "logLevel": "info",
            "pipeline": "${config:skippr.defaultPipeline}"
          },
          {
            "type": "skippr",
            "request": "launch",
            "name": "Skippr: Model",
            "skipprKind": "model",
            "configPath": "${workspaceFolder}/skippr.yml",
            "logLevel": "info",
            "pipeline": "${config:skippr.defaultPipeline}"
          },
          {
            "type": "skippr",
            "request": "launch",
            "name": "Skippr: Doctor",
            "skipprKind": "doctor",
            "configPath": "${workspaceFolder}/skippr.yml",
            "logLevel": "info"
          },
          {
            "type": "skippr",
            "request": "launch",
            "name": "Skippr: Test (dbt)",
            "skipprKind": "test",
            "configPath": "${workspaceFolder}/skippr.yml",
            "logLevel": "info",
            "pipeline": "${config:skippr.defaultPipeline}",
            "skipprTestSelect": "",
            "skipprExtraArgs": ""
          }
        ],
        "configurationSnippets": [
          {
            "label": "Skippr: Discover",
            "description": "Run Skippr discover for a pipeline.",
            "body": {
              "type": "skippr",
              "request": "launch",
              "name": "Skippr: Discover",
              "skipprKind": "discover",
              "configPath": "${workspaceFolder}/skippr.yml",
              "pipeline": "${config:skippr.defaultPipeline}"
            }
          },
          {
            "label": "Skippr: Sync",
            "description": "Run one Skippr sync pass for a pipeline.",
            "body": {
              "type": "skippr",
              "request": "launch",
              "name": "Skippr: Sync",
              "skipprKind": "sync-once",
              "configPath": "${workspaceFolder}/skippr.yml",
              "pipeline": "${config:skippr.defaultPipeline}"
            }
          },
          {
            "label": "Skippr: Model",
            "description": "Run Skippr model for a pipeline.",
            "body": {
              "type": "skippr",
              "request": "launch",
              "name": "Skippr: Model",
              "skipprKind": "model",
              "configPath": "${workspaceFolder}/skippr.yml",
              "pipeline": "${config:skippr.defaultPipeline}"
            }
          },
          {
            "label": "Skippr: Doctor",
            "description": "Run skippr doctor for the workspace config.",
            "body": {
              "type": "skippr",
              "request": "launch",
              "name": "Skippr: Doctor",
              "skipprKind": "doctor",
              "configPath": "${workspaceFolder}/skippr.yml",
              "logLevel": "info"
            }
          },
          {
            "label": "Skippr: Test (dbt)",
            "description": "Run skippr test run (dbt) for a pipeline.",
            "body": {
              "type": "skippr",
              "request": "launch",
              "name": "Skippr: Test (dbt)",
              "skipprKind": "test",
              "configPath": "${workspaceFolder}/skippr.yml",
              "pipeline": "${config:skippr.defaultPipeline}",
              "skipprTestSelect": "",
              "skipprExtraArgs": ""
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "Skippr IDE",
      "properties": {
        "skippr.workspacePath": {
          "type": "string",
          "default": "",
          "description": "Local workspace path for Skippr resources."
        },
        "skippr.apiTarget": {
          "type": "string",
          "default": "",
          "description": "Optional API endpoint for Skippr backend."
        },
        "skippr.auth.baseUrl": {
          "type": "string",
          "default": "https://auth.skippr.io",
          "description": "Skippr Auth API base URL."
        },
        "skippr.cliPath": {
          "type": "string",
          "default": "",
          "description": "Optional advanced override for the Skippr CLI path. Leave empty to use an installed skippr binary on PATH; see skippr.dev.useLocalSkipprd to build from a local skipprd checkout."
        },
        "skippr.dev.reactRoot": {
          "type": "string",
          "default": "",
          "description": "Optional path to a local react checkout for cargo path patches (defaults to ../react next to skipprd). Also honored via SKIPPR_REACT_ROOT."
        },
        "skippr.dev.useLocalSkipprd": {
          "type": "boolean",
          "default": true,
          "description": "When true, run skippr via `cargo run` from a detected local skipprd repo instead of an installed skippr binary. Turn off to force an installed release binary. Requires CodeArtifact auth (CARGO_REGISTRIES_REACT_CARGO_TOKEN) or a sibling ../react checkout."
        },
        "skippr.dev.skipprdRoot": {
          "type": "string",
          "default": "",
          "description": "Optional path to a local skipprd checkout (defaults to a workspace folder named skipprd or ../skipprd). Also honored via SKIPPRD_ROOT."
        },
        "skippr.dev.useLocalRuntimePlugins": {
          "type": "boolean",
          "default": true,
          "description": "When true (default for local IDE dev), build runtime plugins from the skipprd checkout and set USE_LOCAL_PLUGIN_CODE instead of downloading from install.skippr.io. Requires python3 and a detected skipprd repo."
        },
        "skippr.defaultPipeline": {
          "type": "string",
          "default": "",
          "description": "Default pipeline for Skippr runs, debug launch configs (${config:skippr.defaultPipeline}), and gutter Run on skippr.yml."
        },
        "skippr.celebrateFirstSync": {
          "type": "boolean",
          "default": true,
          "description": "Show a full-window confetti animation the first time each pipeline emits sync_start."
        },
        "skippr.logLevel": {
          "type": "string",
          "enum": ["debug", "info", "warn", "error"],
          "default": "info",
          "description": "Log level passed to Skippr run commands."
        },
        "skippr.run.cwd": {
          "type": "string",
          "default": "",
          "description": "Fallback working directory when no --config path is available. When a skippr.yml path is passed, the IDE always runs Skippr from that file's directory (the project root)."
        },
        "skippr.run.extraArgs": {
          "type": "string",
          "default": "",
          "description": "Optional extra CLI arguments for runs started from the Run Skippr title bar (space-separated; basic quoting supported). Merged with launch.json skipprExtraArgs when using debug."
        },
        "skippr.dbtVirtualEnvPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Optional Python virtualenv root used for dbt. When unset, Skippr auto-detects `.venv` or `venv` under the workspace, config folder, or IDE extension/app folders. This sets `DBT_BIN`, `VIRTUAL_ENV`, and prepends the venv bin directory for Skippr CLI spawns."
        },
        "skippr.env": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "markdownDescription": "Extra environment variables merged into **every** Skippr CLI spawn for this workspace folder (after `process.env` and after `.env` / `.env.local` beside `skippr.yml`). Use for values shared across pipelines (e.g. `SKIPPR_HOME`). Per-pipeline overrides: `skippr.pipelineEnv`.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "skippr.pipelineEnv": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "markdownDescription": "Map of **pipeline name** → `{ VAR: value }` merged into Skippr spawns when that pipeline is active (after `skippr.env` and repo `.env` files). Keys must match pipeline names in `skippr.yml`. Set via **Skippr: Edit Pipeline Environment Variables** or `.vscode/settings.json`.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  }
}
